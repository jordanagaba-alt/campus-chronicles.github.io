# Generate a long random value; never commit your real value to GitHub.
ADMIN_TOKEN=replace-with-a-long-random-secret-at-least-24-characters
# Set to your GitHub Pages origin, e.g. https://YOUR-USERNAME.github.io
ALLOWED_ORIGINS=https://YOUR-USERNAME.github.io
# Set this to a path on your hosting provider's persistent disk.
DATA_FILE=/var/data/stories.json
PORT=3000
